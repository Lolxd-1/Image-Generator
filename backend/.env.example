# Supabase Postgres connection string via the pooler, using the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://user:password@host:6543/postgres

# Base URL of your Supabase project.
SUPABASE_URL=https://xxxx.supabase.co

# Supabase service-role key. Server-side only, never sent to the client.
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase storage bucket used for menu photos, dish images, and exports.
SUPABASE_BUCKET=menu-catalog

# Random string of 32+ bytes used to sign the session cookie.
SESSION_SECRET=change-me-to-a-random-32-byte-secret

# urlsafe base64-encoded 32-byte key used to encrypt stored API keys (Fernet).
FERNET_KEY=change-me-to-a-fernet-generated-key

# JSON array of login accounts, e.g. [{"username":"omkar","password":"..."}].
APP_USERS=[{"username":"admin","password":"change-me"}]

# Storage backend to use: "supabase" (default) or "local" (tests/dev only).
STORAGE_BACKEND=supabase

# Local directory used for stored files when STORAGE_BACKEND=local.
LOCAL_STORAGE_DIR=./_storage
